# Server-side only. Never commit a real key. Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Vision-capable model. Check current strings at
# https://docs.claude.com/en/docs/about-claude/models/overview
# Cheaper option for a big room: claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-5

PORT=8787
# 0.0.0.0 lets tablets/laptops on the same Wi-Fi join. Use 127.0.0.1 for solo testing.
HOST=0.0.0.0

# Max simultaneous calls to the API (extra requests queue instead of failing).
MAX_CONCURRENT_CALLS=8

# Optional: $ per million tokens, so the terminal can print a running cost estimate.
# Fill in from https://www.anthropic.com/pricing for the model above. Leave blank to log tokens only.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# 1 = no API calls at all; results are simulated from photos-source/tags.json.
# For rehearsing without a key. The app shows a "mock mode" banner. Never use in a session.
MOCK=0
